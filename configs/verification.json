{
  "seed": 7,
  "device": "cpu",
  "outputs_dir": "outputs_smoke",
  "env": {
    "dt": 0.04,
    "episode_steps": 80,
    "link_lengths": [0.55, 0.45],
    "inertia": [1.0, 0.8],
    "damping": [0.18, 0.14],
    "human_max_torque": [2.8, 2.0],
    "exo_max_torque": [3.2, 2.4],
    "kp": [6.4, 5.2],
    "kd": [1.45, 1.05],
    "assist_kp": [5.5, 4.7],
    "assist_kd": [1.0, 0.75],
    "action_smoothing": 0.55,
    "target_radius_range": [0.35, 0.92],
    "success_threshold": 0.07,
    "success_hold_steps": 4,
    "initial_fatigue_range": [0.1, 0.24],
    "fatigue_gain": 0.042,
    "fatigue_recovery": 0.009,
    "progress_scale": 6.0,
    "success_bonus": 1.6,
    "terminal_success_bonus": 7.5,
    "fatigue_penalty_scale": 0.16,
    "assist_penalty_scale": 0.012,
    "human_effort_scale": 0.24,
    "distance_scale": 1.0,
    "smoothness_scale": 0.018
  },
  "train": {
    "num_envs": 2,
    "total_updates": 4,
    "steps_per_env": 32,
    "gamma": 0.985,
    "gae_lambda": 0.95,
    "clip_coef": 0.2,
    "vf_coef": 0.5,
    "entropy_coef": 0.006,
    "learning_rate": 0.0003,
    "max_grad_norm": 0.5,
    "update_epochs": 2,
    "minibatches": 2,
    "hidden_sizes": [64, 64],
    "log_interval": 1,
    "save_interval": 2
  },
  "eval": {
    "episodes": 6,
    "grid_points": 4
  }
}
